POSTGRES_PASSWORD=replace-with-a-local-password

# Runtime application role: limited to SELECT on football data and CRUD on auth data.
DATABASE_URL=postgresql://golvia_app:replace-with-a-local-password@127.0.0.1:55437/golvia_stage
# Admin-only URL for migration, import and database tests. Do not expose to the app runtime.
DATABASE_ADMIN_URL=postgresql://postgres:replace-with-a-local-admin-password@127.0.0.1:55437/golvia_stage
# Isolated synthetic account-test database only; never point this at real user data.
TEST_DATABASE_URL=postgresql://postgres:replace-with-a-local-admin-password@127.0.0.1:55437/golvia_account_test
# Optional Docker Compose alternative (only when that database is running):
# DATABASE_URL=postgresql://golvia:replace-with-a-local-password@127.0.0.1:5437/golvia

# Configure real contact before live collection. This example is rejected by the collector.
# WIKIDATA_USER_AGENT=GolviaBot/1.0 (contact@example.com)

# Production: public HTTPS origin; reverse proxy routes /socket.io to the socket process.
# GOLVIA_PUBLIC_ORIGIN=https://your-domain.example
# WS_ORIGINS=https://your-domain.example
# WS_HOST=127.0.0.1
# WS_PORT=3001
# BETTER_AUTH_URL=https://your-domain.example
# BETTER_AUTH_SECRET=replace-with-32-or-more-random-characters
# SMTP_URL=smtps://user:password@mail.example:465
# SMTP_FROM=Golvia <noreply@your-domain.example>
# Set the real public origin before npm run build so social metadata uses the correct domain.
# Staging account tests require TEST_DATABASE_URL pointing only to a local golvia_account_test database.
# Local development only: comma-separated LAN hosts for Next.js.
# GOLVIA_DEV_ORIGINS=192.168.1.102

# Only enable behind a trusted reverse proxy that overwrites X-Real-IP on every request.
# Never enable when Next.js or Socket.IO ports are reachable directly.
# TRUST_PROXY=true
# WS_TRUST_PROXY=true

# Optional: preflight calls this base URL's /api/health?check=ready endpoint.
# GOLVIA_READINESS_URL=https://your-domain.example

# Operations (admin credentials, never expose to the runtime):
# npm run db:backup -- --restore-test   # custom dump + isolated golvia_restore_test verification
# npm run account:status -- suspend user@example.com
# npm run account:status -- reactivate user@example.com
# npm run preflight                      # NODE_ENV=production required; fails closed
# PG_BIN can point at a PostgreSQL bin directory containing pg_dump/pg_restore.
